# Credential-free offline defaults. Copy to .env and edit only the local copy.
# See docs/ENV_VARS.md for the full configuration reference.

# Owner authentication: blank generates a password at first local start.
TRADER_OWNER_PASSWORD=
TRADER_SECRET=
TRADER_HTTPS=0
TRADER_ALLOW_INSECURE_LAN=

# Broker: mock is research-only. Select mt5 only with a verified demo terminal.
TRADER_BROKER=mock
TRADER_MT5_INIT_TIMEOUT_MS=60000
TRADER_SYMBOL_MAP=

# AI: mock makes no paid model calls.
TRADER_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_DAILY_TOKEN_BUDGET=200000
TRADER_ALLOW_PAID_AUTORESEARCH=

# Optional external data. An unconfigured/stale calendar blocks trading.
TRADER_CALENDAR_SOURCE=
TRADER_CALENDAR_FEED_URL=
TRADER_CALENDAR_API_KEY=
TRADER_NEWS_FEED_URL=
TRADER_NEWS_API_KEY=
FRED_API_KEY=

# Runtime state is private and excluded from Git.
TRADER_DATA_DIR=data
TRADER_DB=data/trader.db
TRADER_SCHEDULER=0
